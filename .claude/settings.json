{
  "enabledPlugins": {},
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git remote -v)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Read(runs-summary.json)",
      "Edit(DREAMING.md)"
    ]
  },
  "description": "Allowlist mínimo para que la rutina programada orchestos-dreaming (scripts/dreaming) corra sin prompts de permiso en el sandbox cloud, donde el repo se clona fresco y .claude/settings.local.json (gitignored) no está disponible.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/context-budget.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-resume.js\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/startup-guard.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disabledMcpServers": [
    "claude.ai Figma",
    "claude.ai Vercel",
    "claude.ai Supabase",
    "claude.ai Mintlify",
    "claude.ai Gmail",
    "claude.ai Google Drive",
    "claude.ai Google Calendar"
  ],
  "env": {
    "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS": "1",
    "CLAUDE_CODE_DISABLE_ARTIFACT": "1"
  }
}
