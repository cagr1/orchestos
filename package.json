{
  "name": "orchestos",
  "version": "0.12.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "orchestos": "src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:coverage": "bun run scripts/check-coverage.ts",
    "check": "tsc --noEmit",
    "db:migrate": "bun run scripts/migrate-db.ts",
    "e2e:smoke": "bun run src/run/e2e-smoke.ts",
    "e2e:smoke-agents": "bun run src/run/e2e-smoke-agents.ts",
    "dreaming:export": "bun run scripts/export-runs-summary.ts",
    "sources:drift": "bun run scripts/check-sources-drift.ts",
    "sources:drift:summarize": "bun run scripts/check-sources-drift.ts --summarize",
    "ledger:gate": "bun run scripts/check-ledger-gate.ts",
    "ledger:report": "bun run scripts/ledger-report.ts",
    "security:secrets": "bun run scripts/check-secrets.ts --staged",
    "security:secrets:tracked": "bun run scripts/check-secrets.ts --tracked",
    "security:gate": "bun run scripts/security-gate.ts",
    "agent:preflight": "bun run scripts/agent-preflight.ts",
    "agent:live-gate": "bun run scripts/check-live-gate.ts",
    "hooks:check": "bun run scripts/agent-preflight.ts --hooks-only",
    "hooks:install": "bash scripts/install-hooks.sh",
    "mutation:qa": "stryker run stryker.config.mjs",
    "mutation:checks": "stryker run stryker.checks.config.mjs",
    "mutation:sandbox-policy": "stryker run stryker.sandbox-policy.config.mjs",
    "mutation:graph-runner": "stryker run stryker.graph-runner.config.mjs",
    "mutation:run": "stryker run stryker.run.config.mjs",
    "mutation:run:orchestration": "stryker run stryker.run-orchestration.config.mjs",
    "mutation:run:executors": "stryker run stryker.run-executors.config.mjs",
    "mutation:run:runtime-boundaries": "stryker run stryker.run-runtime-boundaries.config.mjs",
    "mutation:run:context-routing": "stryker run stryker.run-context-routing.config.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@types/bun": "^1.3.14",
    "@types/pdfkit": "^0.17.6",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "glob": "^13.0.6",
    "marked": "^18.0.6",
    "pdfkit": "^0.18.0",
    "tesseract.js": "^7.0.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "qs": "6.15.3"
  }
}
